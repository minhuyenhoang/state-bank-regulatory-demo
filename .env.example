# GROQ_API_KEY: Required for Groq API calls (LLM summarization & chat assistant).
# Set this to your Groq API key (gsk_...) in your .env file.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password required for Admin login authentication
ADMIN_PASSWORD="admin123"

MONGODB_USERNAME="MY_MONGODB_USERNAME"
MONGODB_PASSWORD="MY_MONGODB_PASSWORD"
MONGODB_URL="mongodb://localhost:27017"
